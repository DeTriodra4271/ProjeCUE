# dependencies and build output
node_modules/
release/
dist/
*.log

# downloaded by `npm run setup` (see scripts/fetch-cloudflared.js), not stored in git
bin/cloudflared.exe

# signing material and local secrets: never commit
*.pfx
*.p12
*.snk
.env

# design-tool scratch files (screenshots, caches). config.json, design.json and surfaces/ ARE kept
.impeccable/review/
.impeccable/questions/
.impeccable/hook.cache.json

# old "sunflower" icon from before the Cue rename, no longer used
icon3.ico

# generated at build time by `npm run setup` / `npm run release`
THIRD-PARTY-NOTICES.txt

# design-tool notes and metadata: kept on disk, not part of the repo
.impeccable/
PRODUCT.md
DESIGN.md
